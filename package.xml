<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>override_sim</name>
  <version>0.1.0</version>
  <description>VEX V5RC Override (2026-27) simulated using Gazebo Sim: worlds, maps, CAD models, and game behavior nodes. Converted from pushback_sim.</description>
  <maintainer email="kmhswimgirl@gmail.com">kylie herbstzuber</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>otto_navigation</depend>
  <depend>otto_gazebo</depend>
  <depend>otto_description</depend>
  <depend>otto_bringup</depend>

  <build_depend>geometry_msgs</build_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>

  <depend>rosidl_default_runtime</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
    <gazebo_ros gazebo_model_path="${prefix}/worlds"/>
    <gazebo_ros gazebo_model_path="${prefix}"/>
  </export>
</package>
